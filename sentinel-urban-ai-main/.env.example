# UrbanSense AI — Environment Configuration

# Application
NODE_ENV=development
PORT=3000

# Security
# Use a strong secret for session signing in production
SESSION_SECRET=your_secret_here_at_least_32_chars
API_SECRET=analytical_engine_key_123

# Database
# Path to JSON storage directory
DATABASE_PATH=./.data

# In production, set to true to ensure cookies are sent over HTTPS only
SECURE_COOKIES=false
